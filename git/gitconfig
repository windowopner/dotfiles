# Included from ~/.gitconfig (your name/email stay there)
[core]
	pager = delta
	excludesfile = ~/dotfiles/git/gitignore_global
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	syntax-theme = Catppuccin Mocha
[merge]
	conflictStyle = zdiff3
[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[rerere]
	enabled = true
[alias]
	st = status -sb
	lg = log --oneline --graph --decorate -20
	undo = reset --soft HEAD~1
